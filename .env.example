# ==============================================================================
# ASTRAL FAMILY - CONFIGURACIÓN DE ENTORNO (SELF-HOSTED PRODUCTION & DEV)
# Copia este archivo como .env y define tus credenciales seguras.
# NUNCA subas tu archivo .env real con contraseñas al control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Servidor Propio / Red Docker)
# ------------------------------------------------------------------------------
POSTGRES_DB=astral_db
POSTGRES_USER=astral_user
POSTGRES_PASSWORD=CAMBIAR_POR_CONTRASENA_SEGURA_ASTRAL_2026

# URL de conexión interna para Prisma dentro de Docker:
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?schema=public

# ------------------------------------------------------------------------------
# 2. Seguridad, Tokens y Autenticación
# ------------------------------------------------------------------------------
# Llave secreta para firma y verificación de tokens JWT (mínimo 32 caracteres)
JWT_SECRET=CAMBIAR_POR_CLAVE_JWT_ALEATORIA_SUPER_SECRETA_64_CHARS

# Clave secreta general de la aplicación
SECRET_KEY=CAMBIAR_POR_CLAVE_DE_ENCRIPTACION_DE_APLICACION

# ------------------------------------------------------------------------------
# 3. Dominio, URLs y CORS
# ------------------------------------------------------------------------------
# Dominio público de tu servidor o subdominio asignado
APP_URL=https://astral-family.example.com
FRONTEND_URL=https://astral-family.example.com
BACKEND_URL=https://astral-family.example.com

# Puerto local del Reverse Proxy Nginx en el host (por defecto 8080)
HTTP_PORT=8080

# Orígenes permitidos para CORS y WebSockets (separados por coma)
ALLOWED_ORIGINS=https://astral-family.example.com,http://localhost:8080,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Cloudflare Tunnel (Ingreso Seguro sin abrir puertos en el Router)
# ------------------------------------------------------------------------------
# Token del túnel obtenido en Cloudflare Zero Trust Dashboard
# Deja vacío si estás ejecutando en entorno de desarrollo local sin túnel
CLOUDFLARE_TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 5. Inteligencia Artificial (Astro.IA Chatbot - Opcional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
