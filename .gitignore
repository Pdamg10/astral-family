# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# Databases & Backups
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal
prisma/*.db*
prisma/*.sqlite*
postgres_data/
backups/*.sql
backups/*.sql.gz
backups/*.json
!backups/.gitkeep

# Secrets, keys and credentials
*.pem
*.key
*.cert
*.crt
credentials.json
token.json
service-account*.json

# vercel & build
.vercel
/build
/.next/
/out/
*.tsbuildinfo
next-env.d.ts

# debug & logs
*.log
dev.log
dev.out.log
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# custom config/scratch
local-*
.claude
.z-ai-config
test
prompt
/skills/

# Uploads
public/uploads/*
!public/uploads/.gitkeep