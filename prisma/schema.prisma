generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("member") // "admin" | "member"
  avatar       String?
  birthDate    String?  // YYYY-MM-DD
  birthTime    String?  // HH:MM
  city         String?
  country      String?
  timezone     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLogin    DateTime?

  themeSettings  ThemeSettings?
  birthProfiles  BirthProfile[]
  invitations    Invitation[]
  activityEvents ActivityEvent[]
  invitationUsages InvitationUsage[]

  @@index([email])
  @@index([role])
}

model Invitation {
  id           String    @id @default(cuid())
  code         String    @unique
  createdBy    String
  maxUses      Int       @default(1)
  currentUses  Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  creator User @relation(fields: [createdBy], references: [id])
  usages  InvitationUsage[]

  @@index([code])
  @@index([createdBy])
}

model InvitationUsage {
  id           String   @id @default(cuid())
  invitationId String
  userId       String
  usedAt       DateTime @default(now())

  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@index([userId])
}

model BirthProfile {
  id            String   @id @default(cuid())
  name          String
  birthDate     String   // YYYY-MM-DD
  birthTime     String?  // HH:MM, null if unknown
  timeUnknown   Boolean  @default(false)
  city          String
  country       String
  latitude      Float
  longitude     Float
  timezone      String
  createdBy     String
  parentId      String?  // Parent 1 (Father / Mother) Profile ID (optional)
  parent2Id     String?  // Parent 2 (Father / Mother) Profile ID (optional)
  partnerId     String?  // Partner / Spouse Profile ID (optional)
  siblingId     String?  // Sibling Profile ID (optional)
  isCalculated  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent        BirthProfile?   @relation("Parent1Children", fields: [parentId], references: [id], onDelete: SetNull)
  children1     BirthProfile[]  @relation("Parent1Children")

  parent2       BirthProfile?   @relation("Parent2Children", fields: [parent2Id], references: [id], onDelete: SetNull)
  children2     BirthProfile[]  @relation("Parent2Children")

  partner       BirthProfile?   @relation("FamilyPartners", fields: [partnerId], references: [id], onDelete: SetNull)
  partnerOf     BirthProfile[]  @relation("FamilyPartners")
  partnerLinksA PartnerLink[]   @relation("PartnerLinksA")
  partnerLinksB PartnerLink[]   @relation("PartnerLinksB")
  familyLinksFrom FamilyLink[]  @relation("FamilyLinksFrom")
  familyLinksTo   FamilyLink[]  @relation("FamilyLinksTo")

  sibling       BirthProfile?   @relation("FamilySiblings", fields: [siblingId], references: [id], onDelete: SetNull)
  siblingOf     BirthProfile[]  @relation("FamilySiblings")

  creator       User            @relation(fields: [createdBy], references: [id])
  planetaryPositions PlanetaryPosition[]
  houses        House[]
  aspects       Aspect[]
  chartPoints   ChartPoint[]

  @@index([createdBy])
  @@index([parentId])
  @@index([parent2Id])
  @@index([partnerId])
  @@index([siblingId])
  @@index([createdAt])
}

model PartnerLink {
  id         String   @id @default(cuid())
  profileAId String
  profileBId String
  createdAt  DateTime @default(now())

  profileA BirthProfile @relation("PartnerLinksA", fields: [profileAId], references: [id], onDelete: Cascade)
  profileB BirthProfile @relation("PartnerLinksB", fields: [profileBId], references: [id], onDelete: Cascade)

  @@unique([profileAId, profileBId])
  @@index([profileAId])
  @@index([profileBId])
}

model FamilyLink {
  id           String   @id @default(cuid())
  fromId       String
  toId         String
  relationship String   // grandparent, uncle_aunt, cousin, parent_in_law, in_law
  createdAt    DateTime @default(now())

  fromProfile BirthProfile @relation("FamilyLinksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toProfile   BirthProfile @relation("FamilyLinksTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relationship])
  @@index([fromId])
  @@index([toId])
}

model PlanetaryPosition {
  id             String @id @default(cuid())
  birthProfileId String
  body           String  // Sun, Moon, Mercury, Venus, Mars, Jupiter, Saturn, Uranus, Neptune, Pluto
  sign           String  // Aries, Taurus, etc.
  degree         Float
  minute         Float
  retrograde     Boolean @default(false)
  house          Int?

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@unique([birthProfileId, body])
  @@index([birthProfileId])
}

model House {
  id             String @id @default(cuid())
  birthProfileId String
  houseNumber    Int
  sign           String
  degree         Float
  minute         Float

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@unique([birthProfileId, houseNumber])
  @@index([birthProfileId])
}

model Aspect {
  id             String  @id @default(cuid())
  birthProfileId String
  body1          String
  body2          String
  type           String  // conjunction, opposition, trine, square, sextile, quincunx
  angle          Float
  orb            Float
  degree1        Float
  degree2        Float

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@index([birthProfileId])
}

model ChartPoint {
  id             String @id @default(cuid())
  birthProfileId String
  point          String  // NorthNode, SouthNode, Chiron, Lilith, PartOfFortune, Ascendant, MC, DESC, IC
  sign           String
  degree         Float
  minute         Float
  house          Int?

  birthProfile BirthProfile @relation(fields: [birthProfileId], references: [id], onDelete: Cascade)

  @@unique([birthProfileId, point])
  @@index([birthProfileId])
}

model ThemeSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  themeType       String   @default("midnight") // preset name or "custom"
  primaryColor    String   @default("#a855f7")
  secondaryColor  String   @default("#ec4899")
  accentColor     String   @default("#f59e0b")
  backgroundType  String   @default("gradient") // dynamic, gradient, custom-gradient, image, solid
  backgroundColor  String?  // for solid
  backgroundImage  String?  // for custom background image URL
  gradientColors  String   @default("[\"#0f0a1a\",\"#1a0a2e\",\"#0f0a1a\"]")
  cardOpacity     Float    @default(0.85)
  borderRadius    Float    @default(12)
  shadowIntensity Float    @default(0.5)
  textSize        String   @default("medium") // small, medium, large
  infoDensity     String   @default("normal") // compact, normal, spacious
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String   // profile_created, profile_updated, user_joined, etc.
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}